# ============================================================
# foodtruck-agent — example environment variables
# Copy this file to .env and fill in real values for local dev.
# In Render, set these as "Environment Variables" on the service.
# NEVER commit the real .env to GitHub.
# ============================================================

# Square (production)
SQUARE_ACCESS_TOKEN=EAAA...your_token_here
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=LH2NYJ2NCFCXR

# Twilio (only used to send SMS — number comes from Vapi, NOT Twilio)
TWILIO_ACCOUNT_SID=AC...your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
# Twilio sender phone number (the one that will appear as "from" on SMS).
# Twilio gives you a free trial number. After upgrading, you can buy a real one.
# Format: E.164 (e.g., +14073619274).
TWILIO_FROM_PHONE_NUMBER=+1XXXXXXXXXX

# Operator / human escalation
OPERATOR_PHONE_NUMBER=+14073619274

# Tool secret — Vapi sends this in x-tool-secret header
# Render's render.yaml will auto-generate a secure value on first deploy.
TOOL_SECRET=replace_with_a_long_random_string

# Server
PORT=3000
NODE_ENV=production
