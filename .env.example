# ============================================================================
# Rey Tequeño Multi-Tenant Backend - Environment Variables
# ============================================================================
# Copy this to .env and fill in real values.
# In production (Render), set these in Environment settings.
# ============================================================================

# Server
NODE_ENV=production
PORT=10000

# Square (production credentials)
SQUARE_ACCESS_TOKEN=EAAAxxxxx_replace_with_real_token
SQUARE_ENVIRONMENT=production

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxx_replace
TWILIO_AUTH_TOKEN=xxxxx_replace
TWILIO_WHATSAPP_FROM=+14155238886    # Sandbox por ahora; cambiar a Business API tras aprobación
TWILIO_FROM_PHONE_NUMBER=             # Opcional: SMS fallback

# Supabase
SUPABASE_URL=https://hwsjdoucnfzvgbuufbzh.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxx_service_role_key_replace

# Authentication
TOOL_SECRET=reuse_existing_or_generate_new_random_base64

# Optional: Anthropic API (for panel admin Claude chat)
ANTHROPIC_API_KEY=

# Optional: Vapi (para sincronizar prompts vía panel)
VAPI_API_KEY=

# Optional: fallback operator phone if no manager_phone in truck
OPERATOR_PHONE_NUMBER=+14074909276
